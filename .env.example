# Copy to .env and edit. Never commit .env.

# Frontend -> backend
BACKEND_URL=http://localhost:8000

# LLM: mock (offline heuristic, free) | groq | gemini | openrouter | openai | ollama
LLM_PROVIDER=mock
LLM_MODEL=
# Any OpenAI-compatible endpoint (overrides the provider preset)
LLM_BASE_URL=
# Either LLM_API_KEY or <PROVIDER>_API_KEY, e.g. GROQ_API_KEY / GEMINI_API_KEY
LLM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Seconds between LLM calls (free-tier rate limits)
LLM_SLEEP_SECONDS=2

# Storage
KUKU_DATA_DIR=data/scripts
KUKU_OUTPUT_DIR=outputs
KUKU_DB_PATH=outputs/kukupromo.db

# Harness
MAX_RETRIES=2

# Scoring weights (our assumption, not official Kuku criteria)
W_HOOK=0.25
W_CLIFF=0.30
W_STANDALONE=0.20
W_EMOTION=0.15
W_COHERENCE=0.10
